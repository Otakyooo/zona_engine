{
  "name": "zona-launcher",
  "version": "0.1.5",
  "description": "ZONA launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.otakyooo.zona",
    "publish": {
      "provider": "github",
      "owner": "Otakyooo",
      "repo": "zona_engine"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "author": "Otakyooo",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
